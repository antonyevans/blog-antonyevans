---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { formatPostDate, getCategoryLabel, getCategoryUrl, getPostUrl, slugify } from '../lib/content';
import { SITE_AUTHOR, SITE_NAME, getSocialImageForPost, toAbsoluteUrl } from '../lib/site';

interface Props {
  post: CollectionEntry<'blog'>;
  title: string;
  description: string;
  dek?: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  canonical: string;
  relatedPosts?: CollectionEntry<'blog'>[];
}

const { post, title, description, dek, pubDate, updatedDate, category, tags, canonical, relatedPosts = [] } = Astro.props;
const image = getSocialImageForPost(post);
const canonicalUrl = toAbsoluteUrl(canonical);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  author: {
    '@type': 'Person',
    name: SITE_AUTHOR,
  },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  mainEntityOfPage: canonicalUrl,
  image,
  publisher: {
    '@type': 'Person',
    name: SITE_NAME,
  },
};
---

<Layout
  title={`${title} | ${SITE_NAME}`}
  description={description}
  canonical={canonical}
  ogType="article"
  ogImage={image}
  publishedTime={pubDate}
  modifiedTime={updatedDate || pubDate}
  schema={schema}>
  <SiteHeader />
  <main class="post-main">
    <article>
      <header class="container post-header">
        <p class="meta">
          <a class="cat" href={getCategoryUrl(category)}>{getCategoryLabel(category)}</a>
          <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate, 'long')}</time>
          {updatedDate && <span>Updated {formatPostDate(updatedDate)}</span>}
        </p>
        <h1>{title}</h1>
        {dek && <p class="dek">{dek}</p>}
      </header>
      <div class="container">
        <div class="prose">
          <slot />
        </div>
        <footer class="tags" aria-label="Tags">
          {tags.map((tag) => (
            <a class="chip" href={`/blog/tag/${slugify(tag)}/1/`}>#{tag}</a>
          ))}
        </footer>
      </div>
    </article>
    {relatedPosts.length > 0 && (
      <aside class="container related" aria-labelledby="related-head">
        <h2 id="related-head" class="rule-head">Read next</h2>
        <ol>
          {relatedPosts.map((relatedPost, index) => (
            <li>
              <a href={getPostUrl(relatedPost)}>
                <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="kicker">{getCategoryLabel(relatedPost.data.category)}</span>
                <span class="related-title">{relatedPost.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </main>
  <SiteFooter />
</Layout>

<style>
  .post-main { padding-top: 3rem; }

  .post-header {
    padding-bottom: 2.5rem;
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cat {
    background: var(--ink);
    color: var(--bg);
    padding: 0.25rem 0.6rem;
    text-decoration: none;
  }

  .cat:hover { background: var(--accent); color: #ffffff; }

  h1 {
    margin: 1.5rem 0 0;
    font-size: clamp(2.6rem, 6.5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    max-width: 18ch;
  }

  .dek {
    margin: 1.5rem 0 0;
    max-width: 52ch;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .prose {
    max-width: 44rem;
    margin-inline: auto;
    padding-top: 2.5rem;
    border-top: 3px solid var(--ink);
    font-size: 1.1875rem;
    line-height: 1.7;
  }

  .tags {
    max-width: 44rem;
    margin: 3rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .related { margin-top: 6rem; }

  .related ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0 2.5rem;
  }

  .related li { border-bottom: 1px solid var(--line); }

  .related a {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-block: 1.5rem;
    text-decoration: none;
  }

  .related a:hover .related-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }

  .num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.5rem;
    line-height: 0.9;
    color: var(--accent);
  }

  .related-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  :global(.prose > :first-child) { margin-top: 0; }
  :global(.prose p) { margin: 1.1rem 0; }
  :global(.prose h2) {
    margin: 3rem 0 0.75rem;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }
  :global(.prose h3) {
    margin: 2.25rem 0 0.5rem;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  :global(.prose a) { text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
  :global(.prose ul), :global(.prose ol) { padding-left: 1.4rem; }
  :global(.prose li) { margin: 0.4rem 0; }
  :global(.prose li::marker) { color: var(--accent); font-weight: 600; }
  :global(.prose strong) { font-weight: 600; }
  :global(.prose hr) { border: 0; border-top: 3px solid var(--ink); margin: 3rem 0; }
  :global(.prose code) {
    background: var(--accent-soft);
    color: var(--ink);
    border-radius: 3px;
    padding: 0.1rem 0.35rem;
    font-size: 0.9em;
  }
  :global(.prose pre) {
    background: var(--ink);
    color: var(--bg);
    border-radius: 4px;
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  :global(.prose pre code) { background: none; color: inherit; padding: 0; }
  :global(.prose blockquote) {
    margin: 2rem 0;
    padding: 0 0 0 1.5rem;
    border-left: 3px solid var(--accent);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  :global(.prose blockquote p) { margin: 0.5rem 0; }
  :global(.prose table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 1rem;
    margin: 1.5rem 0;
  }
  :global(.prose th), :global(.prose td) {
    border-bottom: 1px solid var(--line);
    padding: 0.6rem 1rem 0.6rem 0;
    text-align: left;
    vertical-align: top;
  }
  :global(.prose th) { border-bottom: 2px solid var(--ink); }
  :global(.prose img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.75rem auto;
    border-radius: 4px;
  }

  @media (max-width: 760px) {
    .post-main { padding-top: 2rem; }
    .prose { font-size: 1.0625rem; }
  }
</style>
