---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ListingHeader from '../../components/ListingHeader.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPublishedPosts, paginateArray } from '../../lib/content';
import { SITE_NAME } from '../../lib/site';

const allPosts = await getPublishedPosts();
const { items, totalPages } = paginateArray(allPosts, 1);
---

<Layout title={`Blog | ${SITE_NAME}`} description="All blog posts by Antony Evans." canonical="/blog/">
  <SiteHeader />
  <main class="container">
    <ListingHeader title="Writing" lede="Essays on agentic commerce, AI systems and running an AI-native company." />
    <section class="post-list" aria-label="Posts">
      {items.map((post) => <PostCard post={post} />)}
    </section>
    <Pagination currentPage={1} totalPages={totalPages} basePath="/blog/" />
  </main>
  <SiteFooter />
</Layout>
