---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { getPublishedProjects } from '../lib/content';
import { SITE_NAME } from '../lib/site';

const projects = await getPublishedProjects();
---

<Layout title={`Projects | ${SITE_NAME}`} description="Projects, tools, and experiments by Antony Evans." canonical="/projects/">
  <SiteHeader />
  <main class="container projects">
    <header class="intro">
      <h1 class="page-title">Building</h1>
      <p class="lede">Tools, systems and experiments — linked directly to the thing itself.</p>
    </header>

    {projects.length > 0 ? (
      <div class="grid">
        {projects.map((project, index) => <ProjectTile project={project} index={index} showActions />)}
      </div>
    ) : (
      <p class="lede">Projects are coming soon.</p>
    )}
  </main>
  <SiteFooter />
</Layout>

<style>
  .projects { padding-block: 3rem 0; }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-bottom: 2rem;
    border-bottom: 3px solid var(--ink);
  }

  .lede {
    margin: 0;
    max-width: 36ch;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17.5rem, 1fr));
    gap: 3rem 2.5rem;
    margin-top: 2.5rem;
  }
</style>
