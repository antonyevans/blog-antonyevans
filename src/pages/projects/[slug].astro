---
import { formatPostDate, getPublishedProjects, getProjectUrl } from '../../lib/content';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE_NAME, toAbsoluteUrl } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const canonical = getProjectUrl(project);
const image = project.data.image ? toAbsoluteUrl(project.data.image) : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.description,
  url: project.data.url,
  mainEntityOfPage: toAbsoluteUrl(canonical),
  ...(image ? { image } : {}),
};
---

<Layout
  title={`${project.data.title} | Projects | ${SITE_NAME}`}
  description={project.data.description}
  canonical={canonical}
  ogImage={image}
  schema={schema}>
  <SiteHeader />
  <main class="container project-main">
    <article>
      <header class="project-header">
        <p class="meta">
          <span class="status">{project.data.status}</span>
          <span>{project.data.category}</span>
          {project.data.launchedDate && (
            <time datetime={project.data.launchedDate.toISOString()}>
              {formatPostDate(project.data.launchedDate, 'long')}
            </time>
          )}
        </p>
        <h1>{project.data.title}</h1>
        <p class="dek">{project.data.description}</p>
        <p class="actions">
          <a class="button" href={project.data.url} target="_blank" rel="noopener noreferrer">Visit project ↗</a>
          {project.data.repoUrl && (
            <a class="button button-ghost" href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>
          )}
        </p>
      </header>

      {project.data.image && (
        <figure>
          <img src={project.data.image} alt={project.data.imageAlt || ''} />
        </figure>
      )}

      <div class="project-body">
        <Content />
      </div>
      <p class="back"><a href="/projects/">← All projects</a></p>
    </article>
  </main>
  <SiteFooter />
</Layout>

<style>
  .project-main { padding-block: 3rem 0; }

  .project-header { padding-bottom: 2.5rem; border-bottom: 3px solid var(--ink); }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .status { background: var(--ink); color: var(--bg); padding: 0.25rem 0.6rem; }

  h1 {
    margin: 1.5rem 0 0;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .dek {
    margin: 1.5rem 0 0;
    max-width: 50ch;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 2rem 0 0; }

  figure { margin: 2.5rem 0 0; }
  figure img { width: 100%; border-radius: 4px; }

  .project-body {
    max-width: 44rem;
    margin: 2.5rem auto 0;
    font-size: 1.1875rem;
    line-height: 1.7;
  }

  .back { max-width: 44rem; margin: 3rem auto 0; font-weight: 600; }
  .back a { color: var(--accent); text-decoration: none; }

  :global(.project-body > :first-child) { margin-top: 0; }
  :global(.project-body p) { margin: 1.1rem 0; }
  :global(.project-body h2) { margin: 2.5rem 0 0.75rem; font-size: clamp(1.75rem, 3vw, 2.25rem); }
  :global(.project-body li::marker) { color: var(--accent); }
  :global(.project-body code) { background: var(--accent-soft); border-radius: 3px; padding: 0.1rem 0.35rem; font-size: 0.9em; }
  :global(.project-body img) { display: block; max-width: 100%; height: auto; margin: 1.75rem auto; border-radius: 4px; }
</style>
