---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectTile from '../components/ProjectTile.astro';
import {
  formatPostDate,
  getCategoryLabel,
  getCategoryUrl,
  getPostUrl,
  getPublishedPosts,
  getPublishedProjects,
  getTopics,
} from '../lib/content';
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/site';

const posts = await getPublishedPosts();
const [lead, ...rest] = posts;
const recent = rest.slice(0, 5);
const topics = getTopics(posts).slice(0, 5);
const projects = (await getPublishedProjects()).slice(0, 3);

const stats = [
  { value: '$50M', label: 'DTC revenue scaled as COO' },
  { value: '$42M', label: 'raised' },
  { value: '500k', label: 'downloads of an AI doctor app' },
  { value: 'YC', label: 'alum, plus Bain and INSEAD' },
];
---

<Layout title={SITE_NAME} description={SITE_DESCRIPTION} canonical="/">
  <SiteHeader variant="masthead" />
  <main>
    {lead && (
      <section class="container front" aria-label="Latest writing">
        <article class="lead">
          <a class="lead-link" href={getPostUrl(lead)}>
            {lead.data.leadStat ? (
              <div class="lead-art">
                <svg class="rings" aria-hidden="true" viewBox="0 0 200 200">
                  <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 4" />
                  <circle cx="100" cy="100" r="70" fill="none" stroke="currentColor" stroke-width="0.6" />
                  <circle cx="100" cy="100" r="44" fill="none" stroke="currentColor" stroke-width="0.6" stroke-dasharray="1 3" />
                </svg>
                <div class="stat">
                  <span class="stat-value">{lead.data.leadStat}</span>
                  {lead.data.leadStatLabel && <span class="stat-label">{lead.data.leadStatLabel}</span>}
                </div>
              </div>
            ) : lead.data.heroImage ? (
              <img class="lead-image" src={lead.data.heroImage} alt={lead.data.heroImageAlt || ''} />
            ) : (
              <div class="lead-art">
                <span class="stat-value small">{getCategoryLabel(lead.data.category)}</span>
              </div>
            )}
            <p class="lead-meta">
              <span class="tag">{getCategoryLabel(lead.data.category)}</span>
              <time datetime={lead.data.pubDate.toISOString()}>{formatPostDate(lead.data.pubDate)}</time>
            </p>
            <h2 class="lead-title"><span class="mark">{lead.data.title}</span></h2>
            <p class="lead-desc">{lead.data.description}</p>
          </a>
        </article>

        <aside class="recent" aria-labelledby="recent-head">
          <h2 id="recent-head" class="rule-head">Also recently</h2>
          <ol>
            {recent.map((post, index) => (
              <li>
                <a href={getPostUrl(post)}>
                  <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <span class="item">
                    <span class="kicker">{getCategoryLabel(post.data.category)} · {formatPostDate(post.data.pubDate, 'short')}</span>
                    <span class="item-title">{post.data.title}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
          <a class="all" href="/blog/">All writing →</a>
        </aside>
      </section>
    )}

    <section class="band" aria-label="What this site is about">
      <div class="container band-inner">
        <p class="band-big">What happens when AI becomes the <span>commerce layer.</span></p>
        <p class="band-small">7 years scaling consumer brands. Now building AI systems. Writing at the intersection — for operators who want the structural view, not the ChatGPT-for-email take.</p>
      </div>
    </section>

    <section class="container topics" aria-labelledby="topics-head">
      <h2 id="topics-head" class="rule-head">Read by topic</h2>
      <ul>
        {topics.map((topic) => (
          <li>
            <a href={topic.url}>
              <span class="topic-name">{topic.label}</span>
              <span class="topic-count">{topic.count} {topic.count === 1 ? 'essay' : 'essays'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="container about" aria-labelledby="about-head">
      <h2 id="about-head" class="visually-hidden">About Antony</h2>
      <dl class="stats">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
      <div class="about-body">
        <div class="monogram" aria-hidden="true">AE</div>
        <div>
          <p class="about-lede">Most DTC commentary is tactical. Most AI commentary is generic. I'm interested in what happens at the intersection.</p>
          <p class="about-text">7 years as COO scaling a DTC consumer brand, through Chapter 11 to profitability. Before that: YC, Bain, INSEAD, and a decade founding things. Cambridge Mathematics.</p>
          <a class="button" href="/about/">More about me →</a>
        </div>
      </div>
    </section>

    {projects.length > 0 && (
      <section class="container building" aria-labelledby="building-head">
        <h2 id="building-head" class="rule-head">Building</h2>
        <div class="project-grid">
          {projects.map((project, index) => <ProjectTile project={project} index={index} />)}
        </div>
        <a class="all" href="/projects/">All projects →</a>
      </section>
    )}
  </main>
  <SiteFooter />
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .front {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    padding-block: 3rem 4.5rem;
  }

  .lead { flex: 999 1 36rem; min-width: 0; }

  .lead-link {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-decoration: none;
    color: var(--ink);
  }

  .lead-link:hover { color: var(--ink); }
  .lead-link:hover .lead-title { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 0.12em; }

  .lead-art {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--accent);
    color: #ffffff;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .lead-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: var(--wash);
  }

  .rings {
    position: absolute;
    width: 65%;
    right: -15%;
    top: -25%;
    opacity: 0.35;
    animation: spin 40s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .stat { position: relative; display: flex; flex-direction: column; gap: 1rem; }

  .stat-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(5rem, 15vw, 15rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
  }

  .stat-value.small { font-size: clamp(2.5rem, 6vw, 5rem); line-height: 0.9; letter-spacing: -0.04em; }

  .stat-label { font-weight: 500; max-width: 34ch; }

  .lead-meta {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tag { background: var(--ink); color: var(--bg); padding: 0.25rem 0.6rem; }

  .lead-title {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .mark {
    background-image: linear-gradient(var(--accent-soft), var(--accent-soft));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 100% 0.32em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    animation: sweep 1.2s 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes sweep { from { background-size: 0% 0.32em; } to { background-size: 100% 0.32em; } }

  .lead-desc {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 60ch;
  }

  .recent {
    flex: 1 1 20rem;
    min-width: 0;
    border-left: 1px solid var(--ink);
    padding-left: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .recent ol { list-style: none; margin: 0; padding: 0; }
  .recent li { border-bottom: 1px solid var(--line); }

  .recent li a {
    display: flex;
    gap: 1.25rem;
    padding-block: 1.5rem;
    text-decoration: none;
  }

  .recent li a:hover .item-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }

  .num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.5rem;
    line-height: 0.9;
    color: var(--accent);
    width: 2.75rem;
    flex-shrink: 0;
  }

  .item { display: flex; flex-direction: column; gap: 0.5rem; }

  .item-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .all {
    display: inline-block;
    margin-top: 1.5rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .all:hover { text-decoration: underline; color: var(--accent-hover); }

  .band { background: var(--ink); color: var(--bg); }

  .band-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 3rem;
    padding-block: 6rem;
  }

  .band-big {
    flex: 999 1 36rem;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .band-big span { color: var(--accent-on-dark); }

  .band-small {
    flex: 1 1 17rem;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--line);
  }

  .topics { padding-block: 6rem 3rem; }
  .topics ul { list-style: none; margin: 0; padding: 0; }
  .topics li { border-bottom: 1px solid var(--line); }

  .topics a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.25rem;
    text-decoration: none;
  }

  .topic-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 6vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
    transition: color 200ms ease, letter-spacing 300ms ease;
  }

  .topics a:hover .topic-name { color: var(--accent); letter-spacing: -0.02em; }

  .topic-count {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
  }

  .about { padding-block: 4.5rem; }

  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    border-top: 3px solid var(--ink);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.75rem;
    padding: 2rem 1.5rem 2rem 0;
    border-bottom: 1px solid var(--line);
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 4.5rem;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .stats dt { color: var(--ink-2); }

  .about-body {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    margin-top: 3.5rem;
    align-items: flex-start;
  }

  .about-body > div:last-child { flex: 999 1 30rem; min-width: 0; }

  .monogram {
    flex: 0 1 20rem;
    aspect-ratio: 1;
    background: var(--ink);
    color: var(--bg);
    border-radius: 4px;
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(5rem, 10vw, 8rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
  }

  .about-lede {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .about-text {
    margin: 1.5rem 0 1.75rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 62ch;
  }

  .building { padding-block: 3rem 0; }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17.5rem, 1fr));
    gap: 2.5rem;
    margin-top: 2rem;
  }

  @media (max-width: 760px) {
    .recent { border-left: 0; padding-left: 0; }
    .front { padding-top: 2rem; }
    .band-inner { padding-block: 4rem; }
    .monogram { flex-basis: 100%; aspect-ratio: 2 / 1; }
  }
</style>
