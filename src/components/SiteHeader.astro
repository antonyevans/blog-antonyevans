---
interface Props {
  /** `masthead` sets the full-width name on the homepage; other pages use the compact bar. */
  variant?: 'masthead' | 'compact';
}

const { variant = 'compact' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/blog/', label: 'Writing' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/search/', label: 'Search' },
];
const isCurrent = (href: string) => path.startsWith(href);
---

<div class="strip">
  <div class="container strip-inner">
    <span>Essays on agentic commerce &amp; AI-native companies</span>
    <span class="strip-links">
      <a href="/rss.xml">RSS</a>
      <a href="https://www.linkedin.com/in/antonyevans/" rel="me">LinkedIn</a>
    </span>
  </div>
</div>

<header class={`site-header ${variant}`}>
  <div class="container">
    {variant === 'masthead' ? (
      <h1 class="masthead-name"><a href="/">Antony Evans</a></h1>
    ) : null}
    <div class="bar">
      {variant === 'compact' ? (
        <a class="wordmark" href="/">Antony Evans</a>
      ) : (
        <span class="tagline">DTC operator → AI builder</span>
      )}
      <nav aria-label="Main">
        {links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  .strip {
    border-bottom: 1px solid var(--ink);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .strip-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 0.75rem;
  }

  .strip a { text-decoration: none; }
  .strip-links { display: flex; gap: 1.25rem; }

  .masthead-name {
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.8rem, 15.6vw, 14.8rem);
    line-height: 0.82;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }

  .masthead-name a {
    color: var(--ink);
    text-decoration: none;
  }

  .masthead-name a:hover { color: var(--ink); }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--ink);
  }

  .masthead .bar {
    margin-top: 1.5rem;
    border-top: 3px solid var(--ink);
  }

  .compact .bar {
    padding-block: 1.1rem;
    border-bottom: 3px solid var(--ink);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    letter-spacing: -0.04em;
    line-height: 1;
    text-decoration: none;
  }

  .tagline {
    font-size: 0.95rem;
    color: var(--muted);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
  }

  nav a {
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    padding-block: 0.6rem;
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  @media (max-width: 760px) {
    .strip-inner > span:first-child { display: none; }
    .strip-inner { justify-content: flex-end; }
    nav { gap: 0 1.25rem; }
    .masthead .tagline { width: 100%; }
  }
</style>
