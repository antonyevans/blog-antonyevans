---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate, getCategoryLabel, getCategoryUrl, getPostUrl } from '../lib/content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const postUrl = getPostUrl(post);
---

<article class="post-row">
  <p class="side">
    <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
    <a class="cat" href={getCategoryUrl(post.data.category)}>{getCategoryLabel(post.data.category)}</a>
  </p>
  <div class="body">
    <h2><a href={postUrl}>{post.data.title}</a></h2>
    <p class="desc">{post.data.description}</p>
  </div>
</article>

<style>
  .post-row {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 4fr);
    gap: 0.75rem 2.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .side {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.4rem;
  }

  .cat { color: var(--accent); text-decoration: none; }
  .cat:hover { text-decoration: underline; color: var(--accent-hover); }

  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.6vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  h2 a { text-decoration: none; }
  h2 a:hover { color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }

  .desc {
    margin: 0.75rem 0 0;
    color: var(--ink-2);
    max-width: 68ch;
  }

  @media (max-width: 760px) {
    .post-row { grid-template-columns: minmax(0, 1fr); }
    .side { flex-direction: row; flex-wrap: wrap; gap: 0.25rem 1rem; padding-top: 0; }
  }
</style>
