---
import { getPublishedPosts, getTopics } from '../lib/content';

interface Props {
  title: string;
  kicker?: string;
  lede?: string;
  /** Category slug to mark as current in the topic row. */
  currentCategory?: string;
}

const { title, kicker, lede, currentCategory } = Astro.props;
const topics = getTopics(await getPublishedPosts());
const isAll = !currentCategory && Astro.url.pathname.startsWith('/blog/') && !Astro.url.pathname.startsWith('/blog/tag/');
---

<header class="listing-header">
  {kicker && <p class="kicker">{kicker}</p>}
  <div class="title-row">
    <h1 class="page-title">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
  <nav class="topic-row" aria-label="Topics">
    <a href="/blog/" class="chip" aria-current={isAll ? 'page' : undefined}>All</a>
    {topics.map((topic) => (
      <a href={topic.url} class="chip" aria-current={topic.category === currentCategory ? 'page' : undefined}>{topic.label}</a>
    ))}
  </nav>
</header>

<style>
  .listing-header {
    padding-block: 3rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .lede {
    margin: 0;
    max-width: 38ch;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .topic-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-block: 1rem;
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .topic-row .chip {
    min-height: 2.5rem;
    padding-inline: 1rem;
  }

  .topic-row .chip[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
  }
</style>
