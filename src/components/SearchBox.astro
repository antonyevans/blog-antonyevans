---
interface Props {
  inputId?: string;
}

const { inputId = 'search-input' } = Astro.props;
---

<section class="search-box">
  <label for={inputId}>Search posts</label>
  <input id={inputId} type="search" placeholder="Title, tag, category..." autocomplete="off" />
  <p class="hint">Results update as you type.</p>
</section>

<script>
  const input = document.querySelector<HTMLInputElement>('.search-box input[type="search"]');
  const results = document.getElementById('search-results');

  if (!input || !results) {
    console.warn('Search UI elements not found on page.');
  }

  async function loadIndex() {
    const response = await fetch('/search-index.json');
    return await response.json();
  }

  function render(items, query) {
    if (!results) return;
    const normalized = query.trim().toLowerCase();
    const filtered = !normalized
      ? items.slice(0, 12)
      : items.filter((item) => {
          return [item.title, item.description, item.category, ...(item.tags || [])]
            .join(' ')
            .toLowerCase()
            .includes(normalized);
        });

    results.innerHTML = filtered.length
      ? filtered
          .slice(0, 50)
          .map(
            (item) =>
              `<article class="result"><h3><a href="${item.url}">${item.title}</a></h3><p>${item.description}</p><p class="meta">${item.category} · ${item.tags.join(', ')}</p></article>`
          )
          .join('')
      : '<p>No matches yet.</p>';
  }

  let index = [];
  loadIndex()
    .then((items) => {
      index = items;
      render(index, '');
    })
    .catch(() => {
      if (results) {
        results.innerHTML = '<p>Search index failed to load.</p>';
      }
    });

  input?.addEventListener('input', () => render(index, input.value));
</script>

<style>
  .search-box {
    display: grid;
    gap: 0.6rem;
    padding-bottom: 1.5rem;
    border-bottom: 3px solid var(--ink);
  }

  label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  input {
    width: 100%;
    border: 0;
    border-bottom: 2px solid var(--ink);
    border-radius: 0;
    background: transparent;
    padding: 0.5rem 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  input:focus { outline: none; border-bottom-color: var(--accent); }
  input::placeholder { color: var(--muted); opacity: 0.6; }

  .hint {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  :global(#search-results) { display: grid; }

  :global(.result) { padding-block: 1.5rem; border-bottom: 1px solid var(--line); }
  :global(.result h3) { margin: 0 0 0.5rem; font-size: clamp(1.4rem, 2.4vw, 1.9rem); letter-spacing: -0.03em; }
  :global(.result h3 a) { color: var(--ink); text-decoration: none; }
  :global(.result h3 a:hover) { text-decoration: underline; text-decoration-thickness: 2px; }
  :global(.result p) { margin: 0; color: var(--ink-2); max-width: 68ch; }
  :global(.result .meta) {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
